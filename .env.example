# Copy to .env.local for development. Never commit real values.
# Use a SEPARATE Supabase project for development and for production.

# Public (shipped to the browser). Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
# The app's own origin, used in email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never paste into client code or logs.
SUPABASE_SECRET_KEY=<your-secret-key>
